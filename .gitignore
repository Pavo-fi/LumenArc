# Build directories
build/
build_mac/
Release/
Debug/
MinSizeRel/
RelWithDebInfo/

# VLC extracted (can be downloaded)
vlc_extracted/
vlc_sdk/

# FFmpeg SDK (can be downloaded, see setup_deps.py / CI)
third_party/ffmpeg/

# Portable distribution files
portable/*

# Keep bundled system DLLs for Windows 10 compatibility
!portable/sysdlls/
!portable/sysdlls/*.dll

# Python cache
__pycache__/
*.pyc

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln.docstates

# OS files
.DS_Store
Thumbs.db

# macOS app bundle (build output)
*.app
*.dmg

# Windows installer
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.exp

# But keep bundled system DLLs for Windows 10 compatibility
!portable/sysdlls/*.dll

# CMake user settings
CMakeUserPresets.json

# Compiled files
*.obj
*.o
*.res
*.tlog
*.log
*.lastbuildstate
*.recipe
*.filelist

# Local test evidence / runtime artifacts
la_b3/
la_at_test/
case.json.lock

# build_tmp 临时产物（历史遗留 tracked 文件不受影响；防误加）
build_tmp/*.png
